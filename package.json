{
  "name": "zbot",
  "version": "1.0.0",
  "description": "Terminal AI assistant",
  "packageManager": "bun@1.3.14",
  "main": "dist-bundle/main.js",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow bun",
    "start": "bun run tui",
    "tui": "bun src/tui/main.ts",
    "build:ui": "cd ui && bun install --silent && bun run build",
    "build": "bun run build:ui && tsc && bun run build.mjs",
    "dev:ui": "cd ui && bun run dev",
    "dev": "bun --watch src/tui/main.ts",
    "test": "bash scripts/test.sh",
    "test:multi-instance": "bun test tests/unit/tui-multi-instance.test.ts",
    "test:render": "bun test src/tui",
    "test:watch": "bun test --watch tests/unit src",
    "test:integration": "bun test tests/integration"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "axios": "^1.15.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "get-east-asian-width": "1.7.0",
    "https-proxy-agent": "^9.1.0",
    "js-yaml": "^5.2.2",
    "openai": "^7.45.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/chokidar": "^2.1.7",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
