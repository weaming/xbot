# Shared fallback settings; local/LAN endpoints may omit the API key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional Responses API profile (overrides the shared settings when selected)
OPENAI_RESPONSES_API_KEY=
OPENAI_RESPONSES_BASE_URL=
OPENAI_RESPONSES_MODEL=
# Optional comma-separated models for /model
OPENAI_RESPONSES_MODELS=
# Optional comma-separated effort choices for /effort
OPENAI_RESPONSES_EFFORTS=
# Optional comma-separated hosted tools the provider runs server-side (e.g. web_search,tool_search);
# declared to the model, never executed locally. Responses-only: Chat Completions has no hosted
# tools at all. For tool_search, MCP servers with defer: true are exposed as deferred Responses
# tools. Requires a provider that hosts these tool types.
# DeepSeek-compatible endpoints only host web_search; models named with both deepseek and flash
# (upstream ignores web search there) and every other tool type are dropped locally.
OPENAI_RESPONSES_HOSTED_TOOLS=

# Optional Chat Completions profile (overrides the shared settings when selected)
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_MODEL=
# Optional comma-separated models for /model
OPENAI_CHAT_MODELS=
# Optional comma-separated effort choices for /effort
OPENAI_CHAT_EFFORTS=

# Optional memory and service settings
NETWORK_PROXY=
OPENAI_PROXY=
